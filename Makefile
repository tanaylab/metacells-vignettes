NAME = metacells-vignettes

ALL_SOURCE_FILES = $(shell git ls-files)

NOTEBOOK_FILES = $(filter notebooks/%.ipynb, $(ALL_SOURCE_FILES))

# Taken from the file system rather than from `git ls-files`, because a pattern rule whose
# prerequisites do not exist is silently skipped, so a stale index would quietly generate nothing.
IMAGE_FILES = $(wildcard images/*)

HTML_FILES = $(patsubst notebooks/%.ipynb, docs/%.html, $(NOTEBOOK_FILES))

PDF_FILES = $(patsubst notebooks/%.ipynb, docs/%.pdf, $(NOTEBOOK_FILES))

# The pages of the site which are written by hand rather than generated from a notebook.
SITE_FILES = $(patsubst site/%, docs/%, $(wildcard site/*))

.DEFAULT_GOAL := help

define PRINT_HELP_PYSCRIPT
import re, sys

for line in sys.stdin:
	match = re.match(r'^([a-zA-Z_-]+):.*?## (.*)$$', line)
	if match:
		target, help = match.groups()
		print("%-20s %s" % (target, help))
endef
export PRINT_HELP_PYSCRIPT

help:
	@python3 -c "$$PRINT_HELP_PYSCRIPT" < $(MAKEFILE_LIST)

clean: clean-docs  ## remove all generated documents

clean-docs:
	rm -f $(HTML_FILES) $(PDF_FILES) $(SITE_FILES)

ci: docs check  ## generate the documents and check them, as the CI server does

.PHONY: check
check: docs  ## check the generated documents are usable
	python3 scripts/check_documents.py

.PHONY: docs
docs: html pdf site  ## generate all the viewable documents

.PHONY: site
site: $(SITE_FILES)  ## copy the hand written pages of the site

docs/%: site/%
	@mkdir -p docs
	cp $< $@

.PHONY: html
html: $(HTML_FILES)  ## generate the viewable HTML documents

.PHONY: pdf
pdf: $(PDF_FILES)  ## generate the viewable PDF documents

# The notebooks are converted as they are, never re-executed: re-running them needs the ~48GB of
# data in `blobs` and an R environment with `MCView`. Embedding the images and clearing the
# `require.js` and `MathJax` URLs (which otherwise point at a CDN) makes each document stand alone,
# so viewing it needs no network and no other file in this repository.
NBCONVERT_FLAGS = \
    --embed-images \
    --HTMLExporter.require_js_url= \
    --HTMLExporter.mathjax_url= \
    --output-dir docs

docs/%.html: notebooks/%.ipynb $(IMAGE_FILES)
	jupyter nbconvert --to html $(NBCONVERT_FLAGS) $<

# A PDF is generated by printing the HTML from a headless chromium, which `playwright` provides. See
# the README for what that needs installed.
#
# The chromium stamps the time it generated the PDF into it, which is the only thing that differs
# between two generations of the same notebook. Replacing it with a fixed date of the same length
# leaves every byte offset in the file intact, and makes the generated PDF reproducible, so that
# comparing two generations shows whether anything actually changed.
docs/%.pdf: notebooks/%.ipynb $(IMAGE_FILES)
	jupyter nbconvert --to webpdf $(NBCONVERT_FLAGS) $<
	sed -i "s/D:[0-9]\{14\}+00'00'/D:20230101000000+00'00'/g" $@
